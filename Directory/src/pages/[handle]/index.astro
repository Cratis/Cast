// A member's full Cast profile, rendered by the directory: from their cast.json for reviewed registry members,
// from public GitHub data for everyone else. The tier and the verification always come from the directory.
import ProfilePage from '@cratis/cast/site/pages/ProfilePage.astro';
import { tierStyles } from '@cratis/cast/badges';
import DirectoryFooter from '../../components/DirectoryFooter.astro';
import DirectoryLead from '../../components/DirectoryLead.astro';
import VerificationPanel from '../../components/VerificationPanel.astro';
import { displayName, everyone, memberPage, type DirectoryMember } from '../../lib/directory';

export function getStaticPaths() {
  return everyone.map((member) => ({ params: { handle: member.handle.toLowerCase() }, props: { member } }));
}

interface Props {
  member: DirectoryMember;
}
const { member } = Astro.props;
const { page, cast } = memberPage(member);
const name = displayName(member);
const style = member.tier ? tierStyles[member.tier] : undefined;
const title = `${cast.person.name} · Cratis Cast ${style?.label ?? ''}`.trim();
const description = `${name} (@${member.handle}) is ${style ? `Cratis Cast ${style.label}: ${style.description.toLowerCase()}` : 'in the Cratis Cast'}. Verified when the directory was built.`;
---

<ProfilePage cast={cast} title={title} description={description}>
  <DirectoryLead slot="lead" />
  <VerificationPanel slot="after-hero" member={member} page={page} />
  <DirectoryFooter slot="footer" navigation />
</ProfilePage>
