// The way back to the directory, at the start of a member profile's navigation.
import CratisMark from '@cratis/cast/site/components/CratisMark.astro';
---

<a href="/" class="group flex shrink-0 items-center gap-2 rounded-md text-fg-muted transition-colors hover:text-fg" aria-label="Back to the Cratis Cast" title="Back to the Cratis Cast">
  <span class="grid size-7 place-items-center rounded-[0.55rem] border border-line-strong bg-ink-900 text-fg transition-transform duration-500 ease-[var(--ease-spring)] group-hover:-rotate-6">
    <CratisMark class="size-4" />
  </span>
  <span class="hidden text-[0.875rem] font-semibold tracking-tight lg:inline">Cast</span>
</a>
<span class="h-5 w-px bg-line-strong" aria-hidden="true"></span>
