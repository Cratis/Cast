{
    "name": "@cratis/cast",
    "version": "1.0.0",
    "description": "Cast: the Cratis profile-site engine. One cast.yaml becomes a verified, event-sourced personal site with a printable CV, live GitHub numbers and a Cast badge.",
    "keywords": [
        "cratis",
        "cast",
        "astro",
        "astro-integration",
        "portfolio",
        "cv",
        "event-sourcing",
        "event-modeling"
    ],
    "author": "Cratis",
    "license": "MIT",
    "homepage": "https://cast.cratis.io",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cratis/Cast.git",
        "directory": "Source/Cast"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "engines": {
        "node": ">=23.0.0"
    },
    "files": [
        "**/*.ts",
        "**/*.astro",
        "**/*.css",
        "**/*.svg",
        "cast.schema.json",
        "cast-json.schema.json",
        "registry/members.yaml",
        "!**/for_*/**",
        "!vitest.config.ts",
        "!scripts/**",
        "README.md"
    ],
    "exports": {
        ".": "./index.ts",
        "./schema": "./config/index.ts",
        "./config": "./config/index.ts",
        "./badges": "./badges/index.ts",
        "./github/*": "./github/*.ts",
        "./cast.schema.json": "./cast.schema.json",
        "./cast-json.schema.json": "./cast-json.schema.json",
        "./machine": "./machine/index.ts",
        "./profile": "./site/profile/index.ts",
        "./package.json": "./package.json",
        "./*": "./*"
    },
    "scripts": {
        "clean": "yarn g:clean",
        "build": "yarn g:tsx scripts/build.ts && yarn g:typecheck",
        "lint": "yarn g:lint",
        "lint:ci": "yarn g:lint:ci",
        "test": "yarn g:test",
        "ci": "yarn g:ci"
    },
    "peerDependencies": {
        "astro": "^7.2.0"
    },
    "dependencies": {
        "@astrojs/sitemap": "^3.7.4",
        "@fontsource-variable/fraunces": "^5.3.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.3.3",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "astro": "^7.4.2"
    }
}
