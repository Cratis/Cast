import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '../styles/global.css';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import type { CastView } from '../profile/CastView';
import { clientCast } from '../profile/clientCast';
import { plainText } from '../lib/inline';
import { accentTokens } from '../lib/accent';
import { safeJson } from '../lib/safeJson';
import CommandPalette from '../components/CommandPalette.astro';
import Terminal from '../components/Terminal.astro';

interface Props {
  cast: CastView;
  title: string;
  description: string;
  /** Path of the OG image under the profile. Defaults to og.png on a Cast site and the portrait elsewhere. */
  image?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const { cast, title, description, image, noindex = false, bodyClass = '' } = Astro.props;
const { config, person, githubUrl, profileLinks, host } = cast;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = image ? cast.href(image) : host.siteFiles ? cast.href('og.png') : cast.photoUrl;
const ogImage = ogImageUrl ? new URL(ogImageUrl, Astro.site) : undefined;
const iconUrl = host.siteFiles ? cast.href('favicon.svg') : '/favicon.svg';
const [firstName, ...rest] = (person.fullName ?? person.name).split(/\s+/);
const themeMode = config.theme.mode;
const accent = accentTokens(config.theme.accent);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  alternateName: [person.fullName, person.handle].filter(Boolean),
  // Directory copies (noindex) carry only the name, links and photo; personal details stay on the member's own site.
  ...(!noindex && person.title ? { jobTitle: person.title } : {}),
  ...(!noindex && person.email ? { email: `mailto:${person.email}` } : {}),
  url: host.siteFiles ? Astro.site?.toString() : config.site.url,
  ...(host.siteFiles ? { image: new URL(cast.href('apple-touch-icon.png'), Astro.site).toString() } : cast.photoUrl ? { image: cast.photoUrl } : {}),
  ...(!noindex && person.location ? { address: { '@type': 'PostalAddress', addressLocality: person.location.split(',')[0]?.trim(), ...(person.country ? { addressCountry: person.country } : {}) } } : {}),
  ...(!noindex && person.interests?.length ? { knowsAbout: person.interests } : {}),
  sameAs: [githubUrl, ...profileLinks.filter((link) => link.key !== 'github').map((link) => link.url)],
};
---

<!doctype html>
<html lang={config.site.language} data-theme-default={themeMode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={plainText(description)} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#08080e" />
    <meta name="color-scheme" content="dark light" />
    <meta name="author" content={person.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="cast:handle" content={person.handle} />

    <link rel="icon" href={iconUrl} type="image/svg+xml" />
    {
      host.siteFiles && (
        <>
          <link rel="apple-touch-icon" href={cast.href('apple-touch-icon.png')} />
          <link rel="sitemap" href={cast.href('sitemap-index.xml')} />
          <link rel="alternate" type="application/json" href={cast.href('cast.json')} title="Cast profile" />
          <link rel="alternate" type="text/plain" href={cast.href('llms.txt')} title="Profile for AI agents" />
        </>
      )
    }

    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={plainText(description)} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && host.siteFiles && <meta property="og:image:width" content="1200" />}
    {ogImage && host.siteFiles && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={`${person.name}: ${plainText(person.tagline)}`} />}
    {firstName && <meta property="profile:first_name" content={firstName} />}
    {rest.length > 0 && <meta property="profile:last_name" content={rest[rest.length - 1]} />}
    <meta property="profile:username" content={person.handle} />
    <meta name="twitter:card" content={host.siteFiles ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={plainText(description)} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script type="application/ld+json" set:html={safeJson(jsonLd)} />
    <style set:html={`:root{--color-accent:${accent.dark};--color-accent-soft:${accent.darkSoft};--color-accent-ink:${accent.ink}}html[data-theme='light']{--color-accent:${accent.light};--color-accent-soft:${accent.lightSoft}}`}></style>

    <script is:inline>
      /* eslint-disable no-var, no-empty, @typescript-eslint/no-unused-vars -- runs before anything else loads, so it stays ES5 */
      // Apply the stored theme and motion preference before first paint, and carry them
      // over to every page the view-transition router swaps in.
      (function () {
        function apply(d) {
          var preference = document.documentElement.getAttribute('data-theme-default') || 'dark';
          var t = preference === 'light' ? 'light' : 'dark';
          if (preference === 'system') t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          try {
            var m = localStorage.getItem('cast:motion');
            if (m === 'reduced' || m === 'full') d.dataset.motion = m;
            var stored = localStorage.getItem('cast:theme');
            if (stored === 'light' || stored === 'dark') t = stored;
          } catch (e) {}
          d.dataset.theme = t;
          d.style.colorScheme = t;
          var reduced =
            d.dataset.motion === 'reduced' ||
            (d.dataset.motion !== 'full' && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
          if (!reduced) d.classList.add('js-motion');
          d.classList.add('js');
          var meta = d.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', t === 'light' ? '#faf9f6' : '#08080e');
        }
        apply(document.documentElement);
        document.addEventListener('astro:before-swap', function (e) {
          apply(e.newDocument.documentElement);
        });
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body class:list={['grain', bodyClass]}>
    <a
      href="#main"
      class="sr-only-focusable fixed top-3 left-3 z-[100] rounded-lg bg-accent px-4 py-2 font-medium text-accent-ink"
      >Skip to content</a
    >
    <slot name="nav" />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <slot name="footer" />
    <script type="application/json" data-cast-client set:html={safeJson(clientCast(cast))} />
    <CommandPalette cast={cast} />
    <Terminal cast={cast} />
    <script>
      import '../scripts/ambient';
    </script>
  </body>
</html>
