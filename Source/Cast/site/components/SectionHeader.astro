import type { CastHost } from '../profile/CastHost';
import Inline from './Inline.astro';

interface Props {
  index: string;
  kind?: 'event' | 'command' | 'view';
  label: string;
  /** May use *emphasis* for the italic serif accent. */
  title: string;
  id?: string;
  /** Where the profile is rendered, for links in the title. */
  host?: CastHost;
}
const { index, kind = 'event', label, title, id, host } = Astro.props;
const noteClass = kind === 'command' ? 'note note-command' : kind === 'view' ? 'note note-view' : 'note';
---

<header class="mb-12 md:mb-16" data-reveal>
  <p class="mb-5 flex items-center gap-3 font-mono text-xs text-fg-faint">
    {index && <span class="text-fg-muted">{index}</span>}
    {index && <span class="h-px w-8 bg-line-strong" aria-hidden="true"></span>}
    <span class={noteClass}>{label}</span>
  </p>
  <h2 id={id} class="section-title max-w-[22ch]"><Inline text={title} host={host} /></h2>
  <slot />
</header>
