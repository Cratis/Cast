// The verified Cast badge. Renders only when the build verified a tier; links to the verification page.
import type { Tier } from '../../badges/Tier';
import { tierStyles } from '../../badges/badgeSvg';
import { verificationUrl } from '../../badges/constants';
import CratisMark from './CratisMark.astro';

interface Props {
  tier: Tier | undefined;
  handle: string;
  size?: 'compact' | 'full';
  class?: string;
}
const { tier, handle, size = 'full', class: className = '' } = Astro.props;
const style = tier ? tierStyles[tier] : undefined;
const href = verificationUrl(handle);
---

{
  style && (
    <a
      href={href}
      rel="noopener"
      class:list={['cast-badge group', `cast-${tier}`, size === 'compact' ? 'is-compact' : 'is-full', className]}
      style={`--tier-from:${style.from};--tier-to:${style.to};--tier-ink:${style.ink}`}
      aria-label={`Cratis Cast ${style.label}: ${style.description}. Verify on cast.cratis.io`}
      title={`Cratis Cast ${style.label} · verified`}
    >
      <span class="cast-badge-left">
        <CratisMark class="cast-badge-mark" />
        <span>Cast</span>
      </span>
      <span class="cast-badge-tier">
        {style.label}
        {size === 'full' && (
          <svg viewBox="0 0 16 16" class="cast-badge-check" aria-hidden="true">
            <path d="M8 1.2 9.6 2.6l2.1-.2.6 2 1.8 1.1-.7 2 .7 2-1.8 1.1-.6 2-2.1-.2L8 14.8l-1.6-1.4-2.1.2-.6-2-1.8-1.1.7-2-.7-2 1.8-1.1.6-2 2.1.2Z" fill="currentColor" opacity=".9" />
            <path d="m5.4 8.2 1.8 1.8 3.5-3.6" fill="none" stroke="var(--tier-from)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        )}
      </span>
    </a>
  )
}

<style>
  .cast-badge {
    position: relative;
    display: inline-flex;
    align-items: stretch;
    border-radius: 0.55rem;
    overflow: hidden;
    font-family: var(--font-sans);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.1) inset,
      0 8px 24px -12px color-mix(in srgb, var(--tier-from) 70%, transparent);
    transition: transform 200ms var(--ease-out-expo), box-shadow 200ms ease;
    isolation: isolate;
  }
  .cast-badge::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.16), transparent 55%);
    pointer-events: none;
  }
  .cast-badge:hover {
    transform: translateY(-1px);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.16) inset,
      0 12px 30px -10px color-mix(in srgb, var(--tier-from) 85%, transparent);
  }
  .cast-badge-left {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-inline: 0.5rem 0.45rem;
    background: #0c0c15;
    color: #f5f3f0;
  }
  .cast-badge-tier {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding-inline: 0.5rem;
    background: linear-gradient(100deg, var(--tier-from), var(--tier-to));
    color: var(--tier-ink);
  }
  .is-compact {
    height: 1.375rem;
    font-size: 0.6875rem;
  }
  .is-full {
    height: 1.75rem;
    font-size: 0.8125rem;
  }
  :global(.cast-badge-mark) {
    width: 0.85rem;
    height: 0.85rem;
  }
  .is-full :global(.cast-badge-mark) {
    width: 1rem;
    height: 1rem;
  }
  .cast-badge-check {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--tier-ink);
  }
  @media print {
    .cast-badge {
      box-shadow: none;
      border: 1px solid #ccc;
    }
  }
</style>
