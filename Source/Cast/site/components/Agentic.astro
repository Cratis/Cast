import SectionHeader from './SectionHeader.astro';
import { agentic as agenticData, config } from '../data';
import { github } from '../lib/github';
import { postsFor, themes } from '../lib/blog';
import { renderInline } from '../lib/inline';

interface Props {
  index: string;
  title?: string;
  label?: string;
}
const agentic = agenticData!;
const { index, title = agentic.title, label = agentic.label } = Astro.props;
const fmt = new Intl.NumberFormat('en-US');
const aiTheme = themes.find((theme) => theme.id === config.writing.agenticTheme);
const aiPosts = postsFor(aiTheme?.id);
const columns = Math.max(1, Math.min(agentic.workflow.length, 6));
const kinds = ['command', 'event', 'view', 'event', 'command'] as const;
---

<section id="agentic" class="relative overflow-hidden py-24 md:py-36" aria-labelledby="agentic-title">
  <div class="pointer-events-none absolute top-1/4 -left-40 size-[36rem] rounded-full bg-view/8 blur-[120px]" aria-hidden="true"></div>
  <div class="container-x relative">
    <SectionHeader index={index} kind="view" label={label} title={title} id="agentic-title">
      <p class="mt-6 max-w-[62ch] text-lg leading-relaxed text-fg-muted" set:html={renderInline(agentic.pitch)} />
    </SectionHeader>

    <div class="panel overflow-hidden" data-reveal data-harness>
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-3 md:px-7">
        <p class="font-mono text-sm"><span class="text-fg-faint">Workflow:</span> <span class="text-view">{agentic.workflowLabel}</span></p>
        <p class="font-mono text-xs text-fg-faint">
          {github.contributions.total > 0 && <><span class="text-fg">{fmt.format(github.contributions.total)}</span> contributions</>}
          {github.contributions.commits ? <> · <span class="text-fg">{fmt.format(github.contributions.commits)}</span> commits</> : null}{github.contributions.total > 0 && ' in the last year'}
        </p>
      </div>
      {agentic.workflow.length > 0 && <ol class="harness relative grid gap-px bg-line" style={`--columns:${columns}`} aria-label="Agent workflow">
        {
          agentic.workflow.map((w, i) => (
            <li class="stage relative bg-ink-900 p-5" style={`--i:${i}`}>
              <span class="flex items-center justify-between font-mono text-[0.6875rem] text-fg-faint">
                <span>{String(i + 1).padStart(2, '0')} · {w.who}</span>
              </span>
              <span class="mt-4 block font-display text-2xl font-[650] tracking-[-0.02em]">{w.step}</span>
              <span class={`note mt-1 ${kinds[i] === 'command' ? 'note-command' : kinds[i] === 'view' ? 'note-view' : ''}`}>{w.event}</span>
              <span class="mt-3 block text-sm leading-relaxed text-fg-muted" set:html={renderInline(w.text)} />
              {w.loop && (
                <span class="loop mt-4 inline-flex whitespace-nowrap items-center gap-1.5 rounded-full border border-event/30 bg-event/8 px-2.5 py-0.5 font-mono text-[0.6875rem] text-event-soft">
                  ↺ {w.loop}
                </span>
              )}
            </li>
          ))
        }
        <span class="pulse pointer-events-none absolute top-0 left-0 hidden h-px md:block" aria-hidden="true"></span>
      </ol>}
    </div>

    <ul class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        agentic.items.map((item, i) => {
          const Tag = item.url ? 'a' : 'div';
          return (
            <li class:list={[item.list && 'md:col-span-2']} data-reveal style={`--reveal-delay:${(i % 3) * 60}ms`}>
              <Tag href={item.url} rel={item.url ? 'noopener' : undefined} class:list={['panel flex h-full flex-col p-5 md:p-6', item.url && 'glow group']} style="--glow: var(--color-view)">
                <span class="note note-view">{item.kind}</span>
                <span class="mt-4 font-display text-2xl font-[650] tracking-[-0.02em] transition-colors group-hover:text-view-soft">{item.name}</span>
                <span class="mt-2 text-sm leading-relaxed text-fg-muted" set:html={renderInline(item.text)} />
                {item.list && (
                  <span class="mt-5 block">
                    <span class="block font-mono text-[0.6875rem] tracking-[0.08em] text-fg-faint uppercase">{item.listLabel}</span>
                    <span class="mt-2 flex flex-wrap gap-1.5">
                      {item.list.map((x) => <span class="tag px-2 py-0.5 text-xs">{x}</span>)}
                    </span>
                  </span>
                )}
              </Tag>
            </li>
          );
        })
      }
    {
      aiPosts.length > 0 && (
        <li class="md:col-span-2" data-reveal><div class="panel h-full p-5 md:px-7">
          <p class="font-mono text-xs text-fg-faint">On the blog · {aiPosts.length} posts about {aiTheme?.label}</p>
          <ul class="mt-3 grid gap-x-8 gap-y-2 md:grid-cols-2">
            {aiPosts.map((p) => (
              <li>
                <a href={p.url} rel="noopener" class="group flex items-baseline gap-3 text-[0.9375rem]">
                  <span class="text-view" aria-hidden="true">→</span>
                  <span class="text-fg group-hover:underline">{p.headline}</span>
                </a>
              </li>
            ))}
          </ul>
        </div></li>
      )
    }
    </ul>

  </div>
</section>

<style>
  @media (min-width: 768px) {
    .harness {
      grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    }
  }
  .pulse {
    width: calc(100% / var(--columns, 5));
    background: linear-gradient(90deg, transparent, var(--color-view), transparent);
    opacity: 0;
  }
  :global(.js-motion) [data-harness].is-visible .pulse {
    animation: harness 7.5s var(--ease-out-expo) infinite;
  }
  @keyframes harness {
    0% { transform: translateX(0); opacity: 0; }
    6% { opacity: 1; }
    94% { opacity: 1; }
    100% { transform: translateX(calc((var(--columns, 5) - 1) * 100%)); opacity: 0; }
  }
  .stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--color-view) 6%, transparent);
    opacity: 0;
    pointer-events: none;
  }
  :global(.js-motion) [data-harness].is-visible .stage::before {
    animation: stage-lit 7.5s ease-in-out infinite;
    animation-delay: calc(var(--i) * 1.5s);
  }
  @keyframes stage-lit {
    0%, 22%, 100% { opacity: 0; }
    8% { opacity: 1; }
  }
</style>
