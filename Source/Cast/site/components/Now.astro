import { Picture } from 'astro:assets';
import { person, now, careerEvents, firstName, photo, photoUrl } from '../data';
import { formatMonth } from '../lib/career';
import { renderInline } from '../lib/inline';
import SectionHeader from './SectionHeader.astro';

interface Props {
  index: string;
  title?: string;
  label?: string;
}
const { index, title = 'Where the stream is *now.*', label = 'Read model' } = Astro.props;
const rows: { key: string; value: string | string[] }[] = Object.entries(now).map(([key, value]) => ({
  key,
  value: typeof value === 'string' && /^\d{4}-\d{2}$/.test(value) ? formatMonth(value) : value,
}));
const hasPortrait = photo !== undefined || photoUrl !== undefined;
---

<section id="about" class="relative py-24 md:py-36" aria-labelledby="about-title">
  <div class="container-x">
    <SectionHeader index={index} kind="view" label={label} title={title} id="about-title" />

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
      {hasPortrait && <figure class="avatar group panel overflow-hidden p-2 lg:col-span-4" data-reveal>
        <div class="relative aspect-square overflow-hidden rounded-[0.9rem]">
          {photo ? <Picture
            src={photo}
            alt={`Portrait of ${person.name}`}
            widths={[320, 500]}
            sizes="(min-width: 1024px) 380px, 90vw"
            formats={['avif', 'webp']}
            loading="lazy"
            class="size-full object-cover"
          /> : <img src={photoUrl} alt={`Portrait of ${person.name}`} width="460" height="460" loading="lazy" class="size-full object-cover" />}
          <div class="tint pointer-events-none absolute inset-0" aria-hidden="true"></div>
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-ink-950/80 to-transparent" aria-hidden="true"></div>
        </div>
        <figcaption class="flex items-center justify-between px-2 pt-3 pb-1 font-mono text-xs text-fg-muted">
          <span>{person.fullName ?? person.name}</span>
          <span class="text-fg-faint">{person.location}</span>
        </figcaption>
      </figure>}

      {rows.length > 0 && <div class:list={['panel overflow-hidden', hasPortrait ? 'lg:col-span-8' : 'lg:col-span-12']} data-reveal style="--reveal-delay:120ms">
        <div class="flex items-center justify-between gap-4 border-b border-line px-5 py-3.5 md:px-7">
          <p class="font-mono text-sm">
            <span class="text-fg-faint">Projection:</span> <span class="text-view">{firstName}.Now</span>
          </p>
          <p class="flex items-center gap-2 font-mono text-xs text-fg-muted">
            <span class="size-1.5 animate-pulse-dot rounded-full bg-view" aria-hidden="true"></span>
            projected from {careerEvents.length} events
          </p>
        </div>
        <dl class="divide-y divide-line">
          {
            rows.map((r) => (
              <div class="grid gap-1 px-5 py-4 sm:grid-cols-[9rem_1fr] sm:gap-6 md:px-7">
                <dt class="font-mono text-xs leading-6 text-fg-faint">{r.key}</dt>
                <dd class="text-[0.975rem] leading-6 text-fg">
                  {Array.isArray(r.value) ? (
                    <ul class="flex flex-wrap gap-2" aria-label={r.key}>
                      {r.value.map((v) => (
                        <li class="tag border-view/25 bg-view/5 text-view-soft">{v}</li>
                      ))}
                    </ul>
                  ) : (
                    <Fragment set:html={renderInline(r.value)} />
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>}
    </div>

    <div class="mt-16 grid grid-cols-1 gap-10 md:mt-24 md:grid-cols-12">
      <h3 class="eyebrow md:col-span-3" data-reveal>About</h3>
      <div class="text-lg leading-relaxed text-fg-muted md:col-span-9 md:columns-2 md:gap-10 [&>p]:mb-6 [&>p]:break-inside-avoid" data-reveal>
        {person.about.map((p, i) => <p class:list={[i === 0 && 'text-fg']} set:html={renderInline(p)} />)}
      </div>
      {person.interests.length > 0 && <h3 class="eyebrow md:col-span-3" data-reveal>Interests</h3>}
      {person.interests.length > 0 && <ul class="flex flex-wrap gap-2 md:col-span-9" data-reveal>
        {person.interests.map((i) => <li class="tag">{i}</li>)}
      </ul>}
    </div>
  </div>
</section>

<style>
  .avatar :global(img) {
    filter: grayscale(1) contrast(1.08) brightness(0.95);
    transition: filter 900ms var(--ease-out-expo), transform 900ms var(--ease-out-expo);
  }
  .tint {
    background: linear-gradient(160deg, var(--color-accent) 0%, #2dd4bf 100%);
    mix-blend-mode: color;
    opacity: 0.55;
    transition: opacity 900ms var(--ease-out-expo);
  }
  .avatar:hover :global(img) {
    filter: none;
    transform: scale(1.03);
  }
  .avatar:hover .tint {
    opacity: 0;
  }
</style>
