{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "verbatimModuleSyntax": false,
        "outDir": "dist",
        "rootDir": "src",
        "noEmit": false,
        "declaration": false,
        "sourceMap": false
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/for_*/**"]
}
